# ==========================================
# VoiceDesk Environment Configuration
# CareBridge Clinic, Hyderabad
# ==========================================

# Database Connection
# Use PostgreSQL in Docker / production: postgresql://voicedesk:password@localhost:5432/voicedesk_db
# Or SQLite for standalone local testing: sqlite:///./voicedesk.db
DATABASE_URL=sqlite:///./voicedesk.db

# Security & JWT Secrets (Change in production)
SECRET_KEY=replace-with-a-random-secret-key-at-least-32-characters-long
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CareBridge2026!

# Clinic Localization
CLINIC_NAME=CareBridge Clinic
CLINIC_TIMEZONE=Asia/Kolkata
ENVIRONMENT=development
DEMO_MODE=true

# LiveKit WebRTC Voice Credentials (Optional - leave blank for Browser Web Speech Demo simulation)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech-to-Text & Text-to-Speech Plugins (Used by livekit-agents worker when Live mode is active)
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# LLM Providers (Optional - leave blank for deterministic tool-calling engine)
# Note: Groq is the implemented live LLM provider.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30.0

# Unverified provider slots (reserved for future adapters; not advertised as working live)
GEMINI_API_KEY=
OPENAI_API_KEY=
